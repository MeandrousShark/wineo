# Example environment config. Copy it to
# ~/.config/wineo/environments/<name>.toml, fill in the required keys, and
# uncomment whatever else applies.

schema_version = 1

# Wine is the default kind, covering both Wine and Proton runners. For a
# native Linux program, start from native-environment.toml.example instead.
# kind = "wine"

# Required. The prefix directory, built on first `wineo start` (or offered by
# `wineo setup`) if it doesn't exist. Must be absolute or start with ~/, for
# example ~/.local/share/wineo/prefixes/<name>.
prefix = "[PREFIX-DIR]"
# Required. A runner name from `wineo runners`, `wine` for the system wine, or
# an alias like `GE-Proton-Latest` or `Proton-CachyOS-Latest`.
runner = "GE-Proton-Latest"
# Required. `win64` or `win32`. Proton is always win64.
arch = "win64"

# Tags for filtering with `wineo list --tag`. Default: none.
# tags = ["game", "co-op"]

# Run under gamemode. Default: the global setting.
# gamemode = true

# Show the MangoHud overlay. Under gamescope this is gamescope's --mangoapp.
# Default: the global setting.
# mangohud = true

# Use Wine's Wayland driver instead of X11. Needs a runner that supports it
# and a Wayland session; outside one the game starts on X11 with a note.
# Default: the global setting.
# wayland = true

# The umu id protonfixes looks this game up by. Default: no fixes applied.
# gameid = "umu-1234567890"

# The store the game came from; some protonfixes branch on it. Default: unset.
# store = "steam"

# The DXVK build for this prefix, or "latest" for the newest installed. Needs
# a Wine runner; refused on Proton. Default: none installed.
# dxvk = "latest"

# The vkd3d-proton build for this prefix. Needs dxvk set too, since
# vkd3d-proton has no DXGI of its own. Needs a Wine runner; refused on Proton.
# Default: none installed.
# vkd3d = "latest"

# The Heroic game id this environment was imported from. Only a Heroic import
# sets this. Default: unset.
# heroic_id = "abcdef0123456789"

# Run every target under gamescope. Every field is optional, and an empty
# table runs plain `gamescope --`. A target's own [targets.<name>.gamescope]
# replaces this whole table. Default: off.
# [gamescope]
# width = 1920  # -w, the resolution the game renders at.
# height = 1080  # -h
# output_width = 2560  # -W, the window or screen size.
# output_height = 1440  # -H
# filter = "fsr"  # -F: linear, nearest, fsr, nis, pixel, or sgsr.
# scaler = "fit"  # -S: auto, integer, fit, fill, or stretch.
# window = "fullscreen"  # -f, or "borderless" for -b.
# fps_limit = 60  # -r
# fps_limit_unfocused = 10  # -o, the limit while the window isn't focused.
# grab_cursor = true  # --force-grab-cursor
# args = ["--hdr-enabled"]  # Any other gamescope flags, passed last.

# Extra environment variables for every launch in this prefix. WINEPREFIX is
# managed by wineo and can't be set here. Default: none.
# [env]
# DXVK_HUD = "1"

# One table per program to launch, started with `wineo start <env>.<target>`.
# Only one target can be the default.

# [targets.game]
# exe = 'C:\Program Files\Game\Game.exe'  # Required.
# args = ["-nosplash"]  # Arguments for the exe. Any given on the command line come after.
# cwd = 'C:\Program Files\Game'  # Default: the exe's own directory.
# default = true  # What `wineo start <env>` launches when there are several targets.
# gamemode = true  # Overrides the environment's own gamemode setting for this target.
# mangohud = true  # Likewise for mangohud.
# wayland = true  # Likewise for wayland.
# desktop = true  # Whether this target gets a desktop entry. Default: false.
# name = "My Game"  # What the desktop entry is called. Default: the target's own name.

# [targets.launcher]
# exe = "~/Games/game/launcher.exe"  # A Unix path works too, and can start with ~ for your home.
# gamescope = false  # Turns off the environment's gamescope for this target.
